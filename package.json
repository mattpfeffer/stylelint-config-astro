{
    "name": "stylelint-config-astro",
    "version": "2.0.0",
    "description": "A shareable Stylelint config for linting Astro files.",
    "author": "Matt Pfeffer (https://github.com/mattpfeffer)",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mattpfeffer/stylelint-config-astro.git"
    },
    "keywords": [
        "stylelint",
        "config",
        "stylelint-config",
        "astro"
    ],
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js",
            "default": "./dist/esm/index.js"
        },
        "./astro": {
            "import": "./dist/esm/astro.js",
            "require": "./dist/cjs/astro.js",
            "default": "./dist/esm/astro.js"
        },
        "./vue": {
            "import": "./dist/esm/vue.js",
            "require": "./dist/cjs/vue.js",
            "default": "./dist/esm/vue.js"
        },
        "./svelte": {
            "import": "./dist/esm/svelte.js",
            "require": "./dist/cjs/svelte.js",
            "default": "./dist/esm/svelte.js"
        },
        "./html": {
            "import": "./dist/esm/html.js",
            "require": "./dist/cjs/html.js",
            "default": "./dist/esm/html.js"
        }
    },
    "files": [
        "dist/"
    ],
    "scripts": {
        "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true });\"",
        "build": "pnpm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node ./.scripts/fix-cjs.cjs",
        "types": "tsc -p tsconfig.json -w",
        "next": "node ./.scripts/next-version.cjs",
        "release": "commit-and-tag-version",
        "prepare": "husky"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "@types/node": "^24.9.1",
        "@typescript-eslint/eslint-plugin": "^8.46.2",
        "@typescript-eslint/parser": "^8.46.2",
        "commit-and-tag-version": "^12.6.0",
        "conventional-recommended-bump": "^11.2.0",
        "eslint": "^9.38.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-n": "^17.23.1",
        "eslint-plugin-promise": "^7.2.1",
        "husky": "^9.1.7",
        "neostandard": "^0.12.2",
        "prettier": "^3.6.2",
        "semver": "^7.7.3",
        "stylelint": "^14.16.1",
        "stylelint-config-standard": "^26.0.0"
    },
    "peerDependencies": {
        "postcss-html": "^1.0.0",
        "stylelint": ">=14.0.0"
    },
    "dependencies": {
        "typescript": "^5.9.3"
    },
    "packageManager": "pnpm@10.19.0"
}
